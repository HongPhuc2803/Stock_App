rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function ownerOf(storeId) {
      return signedIn() && profile().isActive == true &&
        profile().storeId == storeId && profile().role == 'OWNER';
    }
    function memberOf(storeId) {
      return signedIn() && profile().isActive == true &&
        profile().storeId == storeId;
    }

    match /stores/{storeId}/products/{fileName} {
      allow read: if memberOf(storeId);
      allow create, update: if ownerOf(storeId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if ownerOf(storeId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
